<?jelly escape-by-default='true' ?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler"
         xmlns:f="/lib/form"
>
    <j:set var="escapeEntryTitleAndDescription" value="false"/>
    <f:entry title="${h.escape(it.name)}" description="${it.formattedDescription}">
        <div name="parameter" class="tgp-container">
            <input type="hidden" name="name" value="${it.name}"/>
            <j:set var="firstSelectedUid" value=""/>

            <!-- Tab links -->
            <div id="projectstatus-tabBar">
                <div class="tabBarFrame">
                    <div class="tabBar">
                        <j:forEach var="tab" items="${it.tabs}" indexVar="index">
                            <j:set var="active" value=""/>
                            <j:if test="${index==0}">
                                <j:set var="active" value="active"/>
                                <j:set var="firstSelectedUid" value="${tab.uid}"/>
                            </j:if>
                            <div class="tab ${active}" data-tab-uid="${tab.uid}" data-selected-tab-id="selected-tab-input-${h.escape(it.name)}">
                                <a name="${tab.uid}" data-tab-uid="${tab.uid}" data-selected-tab-id="selected-tab-input-${h.escape(it.name)}" class="tgp-tablinks">${tab.name}</a>
                            </div>
                        </j:forEach>
                    </div>
                </div>
            </div>
            <input type="hidden" id="selected-tab-input-${h.escape(it.name)}" name="selectedTabUid" value="${firstSelectedUid}"/>

            <j:forEach var="tab" items="${it.tabs}" indexVar="index">
                <j:set var="hiddenClass" value=""/>
                <j:if test="${index!=0}">
                    <j:set var="hiddenClass" value="jenkins-hidden"/>
                </j:if>
                <!-- Tab content -->
                <div name="tabsValues" id="${tab.uid}" class="tgp-tab__content ${hiddenClass}">
                    <input type="hidden" name="uid" value="${tab.uid}"/>
                    <input type="hidden" name="name" value="${tab.name}"/>
                    <j:forEach var="parameterDefinition" items="${tab.parameters}">
                        <j:set var="escapeEntryTitleAndDescription" value="true"/> <!-- SECURITY-353 defense unless overridden -->
                        <tbody>
                            <st:include it="${parameterDefinition}"
                                        page="${parameterDefinition.descriptor.valuePage}"/>
                        </tbody>
                    </j:forEach>
                </div>
            </j:forEach>
        </div>
    </f:entry>
    <st:adjunct includes="io.jenkins.plugins.TabsGroupParameterDefinition.tabs"/>
</j:jelly>
