<?xml version="1.0" encoding="UTF-8"?>
<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:st="jelly:stapler">
    <j:set var="escapeEntryTitleAndDescription" value="false"/>
    <f:entry title="${h.escape(it.name)}">
        <div name="parameter">
            <input type="hidden" id="selected-tab-input" name="selectedTab"/>
            <!-- Tab links -->
            <div id="projectstatus-tabBar">
                <div class="tabBarFrame">
                    <div class="tabBar">
                        <j:forEach var="tab" items="${it.tabsValues}">
                            <j:set var="active" value=""/>
                            <j:if test="${it.isSelectedTab(tab)}">
                                <j:set var="active" value=" active"/>
                            </j:if>
                            <div class="tab${active}" data-tab-uid="${tab.uid}">
                                <!-- How to disable the link ?  -->
                                <a name="${tab.uid}" data-tab-uid="${tab.uid}" disabled="true" class="tgp-tablinks">${tab.name}</a>
                            </div>
                        </j:forEach>
                    </div>
                </div>
            </div>

            <j:set var="tab" value="${it.selectedTab}"/>
            <!-- Tab content -->
            <div name="tabsValues" id="${tab.uid}" class="tgp-tab__content">
                <j:forEach var="parameterValue" items="${tab.parameters}">
                    <st:include it="${parameterValue}" page="value.jelly"/>
                </j:forEach>
            </div>
        </div>
    </f:entry>
    <st:adjunct includes="io.jenkins.plugins.TabsGroupParameterDefinition.tabs"/>
</j:jelly>
